# Copy to .env and fill in. Never commit .env: the repository is public.
# Every variable the server reads is here. In production they live in Render's dashboard instead:
# render.yaml lists them all, and docs/deploy.md says where each value comes from.

# Render sets PORT itself (10000); locally the Vite proxy expects 5000.
PORT=5000
# The SPA's origin, no trailing slash: the CORS origin in development and the base of the links in
# emails. In production, the Vercel URL (e.g. https://<project>.vercel.app).
CLIENT_URL=http://localhost:5173
# How many proxies in front of the app to trust. The coarse per-IP sign-in and code-email ceilings
# key on every address they forwarded. Default 1: Render's own proxy. Requests through the Vercel
# rewrite pass two (Vercel, then Render), so render.yaml sets 2. With 1, every visitor would share
# Vercel's address, and one of them could lock the rest out of sign-in. Too many only gives someone
# forging X-Forwarded-For fresh counters of their own (docs/deploy.md §6). Irrelevant locally.
# TRUST_PROXY_HOPS=1

# production: JSON logs at info. Anything else: pretty logs at debug (pino-pretty, a dev dependency).
# production also makes the refresh cookie Secure (HTTPS only), makes OTP_PEPPER required, and never
# writes an email (OTP codes included) to the log when SMTP isn't configured.
NODE_ENV=development
# Optional override: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info

# MongoDB Atlas connection string (required). Put the database name in the path, e.g. /campuscommons,
# otherwise data lands in a database called "test".
# A local MongoDB works too (no replica set needed): mongodb://127.0.0.1:27017/campuscommons
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscommons?retryWrites=true&w=majority

# Long random strings, different for each environment. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
# Never reuse a value from an old commit: the early history of this repository holds a .env whose
# secrets are public. Changing REFRESH_TOKEN_SECRET signs everyone out.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Redis (Upstash or Redis Cloud): the TCP connection string from the dashboard, not the REST URL.
# Upstash's starts with rediss:// (TLS). A local Redis: redis://127.0.0.1:6379
# Without Redis the API still starts (no cache), but bookings and sign-ins answer 503.
REDIS_URL=rediss://default:<password>@<host>:6379

# Registration: only these email domains can register (comma-separated).
ALLOWED_EMAIL_DOMAINS=nitjsr.ac.in
# A long random string mixed into OTP hashes in Redis. Generate it like the token secrets.
# Changing it voids the codes already sent.
OTP_PEPPER=
# true shows the demo role buttons on the login page and enables POST /auth/demo-login
# (the seeded @demo.campuscommons.test users). Turn it off for a real deployment.
# While it's on, anyone can sign in as the demo admin, so a DEMO_MODE=true instance is demo-only:
# no real students on it (docs/deploy.md §12).
DEMO_MODE=true
# Password for the seeded demo users (npm run seed). Put it in the submission's testing notes.
# 8-72 characters with at least one letter and one digit. The server itself never reads it.
SEED_PASSWORD=

# Email (OTP codes). Gmail app password or Brevo SMTP. Without SMTP_HOST, emails (and OTPs) are
# logged to the server console instead of sent. Addresses on *.test are never emailed.
#   Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_USER = the SMTP login, SMTP_PASS = an SMTP key.
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER = the address, SMTP_PASS = a 16-character app password.
# 465 means TLS from the start; any other port upgrades with STARTTLS. Render's free instances block
# 25, 465 and 587: use Brevo on 2525 there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# A sender Brevo has verified, or the Gmail address itself (Gmail rewrites any other From).
MAIL_FROM="CampusCommons <no-reply@example.com>"

# Cloudinary (ID cards, badge evidence and condition photos). From the Cloudinary dashboard.
# Without all three, uploads answer 503 and everything else works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cron sweeper (reminders, no-shows, overdue returns). false turns it off.
CRON_ENABLED=true

# AI quota: only used once AI features exist. Set the global cap below what AI Studio shows.
AI_USER_BURST_SECONDS=10
AI_USER_DAILY_LIMIT=5
AI_GLOBAL_RPM=8
AI_GLOBAL_DAILY_LIMIT=50

# ── Scripts only (the server never reads these) ─────────────────────────────
# npm run golden-path: the server to run against when no URL is given (default http://localhost:$PORT).
# GOLDEN_PATH_URL=https://<project>.vercel.app
# The integration tests read TEST_MONGODB_URI from the shell, never from this file:
#   TEST_MONGODB_URI=mongodb://127.0.0.1:27017 node --test
